# URL del Web App de Google Apps Script (termina en /exec).
# Se obtiene al desplegar el backend. NO es un secreto crítico, pero sí necesario.
VITE_API_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Token de aplicación compartido. Debe coincidir con APP_TOKEN en Apps Script
# (Script Properties). Limitación conocida: al ser una app pública, este token
# es visible en el tráfico de red. Ver docs/01-arquitectura.md (seguridad).
VITE_APP_TOKEN="cambia-este-token"

# Ruta base para GitHub Pages. Debe coincidir con el nombre del repositorio.
# Ej.: repo "vetnote" -> "/vetnote/". En dominio propio/raíz -> "/".
VITE_BASE_PATH="/vetnote/"
